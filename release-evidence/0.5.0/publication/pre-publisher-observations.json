    "target_commitish": "4a45b99927082e1448a963140d4895c4ae82a4c7",
    "name": "0.5.0 alpha \u2014 bounded 4K painting and guarded UV edits",
    "draft": true,
    "immutable": false,
    "prerelease": true,
    "created_at": "2026-10-25T07:43:30Z",
